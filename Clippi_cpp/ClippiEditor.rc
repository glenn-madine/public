#include <windows.h>
#include "resource.h"

// Same icon as Clippi
IDI_APPICON ICON "Clippi.ico"

// Version information (shown in Explorer: right-click the .exe > Properties > Details)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Clippi Editor - edits Clippi's buttons"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "ClippiEditor"
            VALUE "OriginalFilename", "ClippiEditor.exe"
            VALUE "ProductName",      "Clippi"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
