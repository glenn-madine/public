#include <windows.h>
#include "resource.h"

// The first icon resource is also the icon Explorer shows for the .exe.
IDI_APPICON ICON "Clippi.ico"

// Default button definitions, embedded in the .exe. Written to
// %USERPROFILE%\Clippi_Storage\ClipBoardButtonDefinitions.json on first run.
IDR_DEFAULT_JSON RCDATA "ClipBoardButtonDefinitions.json"

// Version information (shown in Explorer: right-click the .exe > Properties > Details)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 PRODUCTVERSION APP_VERSION_MAJOR, APP_VERSION_MINOR, APP_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "Clippi - Clipboard Buttons"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "ClipBoardButtons"
            VALUE "OriginalFilename", "ClipBoardButtons.exe"
            VALUE "ProductName",      "Clippi"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
