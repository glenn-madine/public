// DDLaunchEdit.rc -- resources for DDLaunch+ Editor (version from version.h)
//
// Build:  rc /nologo DDLaunchEdit.rc      (produces DDLaunchEdit.res)
// Then link DDLaunchEdit.res with /MANIFEST:NO (see DDLaunchEdit.cpp header).

#include <windows.h>
#include "resource.h"
#include "version.h"   // DDLAUNCHEDIT_VERSION_*, DDLAUNCH_AUTHOR

// Same icon as DDLaunch+ (IDI_ICON1 in resource.h), 16 to 256 px.
IDI_ICON1 ICON "DDLaunch.ico"

// Application manifest -- the only manifest source for the .exe.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "DDLaunchEdit.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     DDLAUNCHEDIT_VERSION_RC
 PRODUCTVERSION  DDLAUNCHEDIT_VERSION_RC
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      DDLAUNCH_AUTHOR
            VALUE "FileDescription",  "DDLaunch+ Editor - edits connections.json and actionDefinitions.json"
            VALUE "FileVersion",      DDLAUNCHEDIT_VERSION_STR
            VALUE "InternalName",     "DDLaunchEdit"
            VALUE "OriginalFilename", "DDLaunchEdit.exe"
            VALUE "ProductName",      "DDLaunch+"
            VALUE "ProductVersion",   DDLAUNCHEDIT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
