// DDLaunch.rc -- resources for DDLaunch+ (version from version.h, R16)
//
// Build:  rc /nologo DDLaunch.rc      (produces DDLaunch.res)
// Then link DDLaunch.res with /MANIFEST:NO (see DDLaunch.cpp header).
//
// If you already have a DDLaunch.rc, you only need to add the MANIFEST
// line below to it (and remove any other RT_MANIFEST / "24" resource).

#include <windows.h>
#include "resource.h"
#include "version.h"   // DDLAUNCH_VERSION_*, DDLAUNCH_AUTHOR

// ---------------------------------------------------------------------------
// Icon (IDI_ICON1 is defined in resource.h). DDLaunch.ico holds 16 to 256 px
// 32-bit images, so Windows picks a sharp one at every DPI (R22).
// ---------------------------------------------------------------------------
IDI_ICON1 ICON "DDLaunch.ico"

// ---------------------------------------------------------------------------
// Application manifest -- the single manifest source for the .exe (R11).
// CREATEPROCESS_MANIFEST_RESOURCE_ID = 1, RT_MANIFEST = 24.
// ---------------------------------------------------------------------------
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "DDLaunch.manifest"

// ---------------------------------------------------------------------------
// Version information (shown in File Explorer > Properties > Details)
// ---------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     DDLAUNCH_VERSION_RC
 PRODUCTVERSION  DDLAUNCH_VERSION_RC
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      DDLAUNCH_AUTHOR
            VALUE "FileDescription",  "DDLaunch+ Data-Driven Launcher"
            VALUE "FileVersion",      DDLAUNCH_VERSION_STR
            VALUE "InternalName",     "DDLaunch"
            VALUE "OriginalFilename", "DDLaunch.exe"
            VALUE "ProductName",      "DDLaunch+"
            VALUE "ProductVersion",   DDLAUNCH_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
