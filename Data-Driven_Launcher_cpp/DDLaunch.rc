// DDLaunch.rc -- resources for DDLaunch+ v2.4.1
//
// Build:  rc /nologo DDLaunch.rc      (produces DDLaunch.res)
// Then link DDLaunch.res with /MANIFEST:NO (see DDLaunch.cpp header).
//
// If you already have a DDLaunch.rc, you only need to add the MANIFEST
// line below to it (and remove any other RT_MANIFEST / "24" resource).

#include <windows.h>
#include "resource.h"

// ---------------------------------------------------------------------------
// Icon (IDI_ICON1 is defined in resource.h). Adjust the file name if your
// icon file is called something else.
// ---------------------------------------------------------------------------
IDI_ICON1 ICON "DDLaunch.ico"

// ---------------------------------------------------------------------------
// Application manifest -- the single manifest source for the .exe (R11).
// CREATEPROCESS_MANIFEST_RESOURCE_ID = 1, RT_MANIFEST = 24.
// ---------------------------------------------------------------------------
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "DDLaunch.manifest"

// ---------------------------------------------------------------------------
// Version information (shown in File Explorer > Properties > Details)
// ---------------------------------------------------------------------------
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     2,4,1,0
 PRODUCTVERSION  2,4,1,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Glenn Madine"
            VALUE "FileDescription",  "DDLaunch+ Data-Driven Launcher"
            VALUE "FileVersion",      "2.4.1.0"
            VALUE "InternalName",     "DDLaunch"
            VALUE "OriginalFilename", "DDLaunch.exe"
            VALUE "ProductName",      "DDLaunch+"
            VALUE "ProductVersion",   "2.4.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
