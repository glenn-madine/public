(show (format nil "~a/~s/~%~~" 'x "y"))
(defmacro swap (a b) `(let ((tmp ,a)) (setq ,a ,b) (setq ,b tmp)))
(setq p 1 q 2) (swap p q) (show (list p q))
(show (macroexpand '(swap p q)))
(defun kf (a &optional (b 2 bp) &rest r &key (k 9) &aux (z 7)) (list a b bp r k z))
