(setq counter-class (send class :new '(count)))
(send counter-class :answer :isnew '() '((setq count 0) self))
(send counter-class :answer :inc '() '((setq count (1+ count))))
(setq sub-class (send class :new '(extra) '() counter-class))
(send sub-class :answer :inc '() '((send-super :inc) (send-super :inc)))
(setq c1 (send sub-class :new))
(send c1 :inc) (show (send c1 :inc))
(send c1 :show)
(show (progv '(dyn1 dyn2) '(10 20) (+ dyn1 dyn2)))
