+        Match => "~", NoMatch => "!~", Plus => "+", Minus => "-", Star => "*", Slash => "/",
+        Percent => "%", Caret => "^", Incr => "++", Decr => "--", Question => "?", Colon => ":",
+        Pipe => "|", Append => ">>",
+        _ => "?",
+    }
